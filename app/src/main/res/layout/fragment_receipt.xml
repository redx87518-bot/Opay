<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:context=".ui.fragment.ReceiptFragment">
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:radius="16dp"
            android:elevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/gradient_gold">

                <ImageView
                    android:src="@drawable/ic_launcher_foreground"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:text="GoldPay"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />

                <TextView
                    android:text="Transaction Receipt"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:alpha="0.9"
                    android:layout_gravity="center"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:radius="12dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:text="Transaction Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_700"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Status"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:text="Successful"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_500" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_300" android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Transaction Type"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvType"
                        android:text="Wallet Transfer"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Amount"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvAmount"
                        android:text="₦50,000.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold_primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Transaction ID"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTxId"
                        android:text="TXN1234567890"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_300" android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="From"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvFrom"
                        android:text="John Doe"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="To"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTo"
                        android:text="Jane Smith"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_300" android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Date"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:text="15-09-2026"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Time"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:text="14:30:00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSaveReceipt"
            android:text="Save Receipt as Image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/gold_primary"
            android:textColor="@android:color/white"
            android:padding="14dp"
            android:textSize="16sp"
            
            
             />

        <Button
            android:id="@+id/btnShareReceipt"
            android:text="Share Receipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/gray_300"
            android:textColor="@color/gray_700"
            android:padding="14dp"
            android:textSize="16sp"
            
            
             />

    </LinearLayout>

</ScrollView>
</layout>

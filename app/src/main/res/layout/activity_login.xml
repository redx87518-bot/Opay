<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_100"
    android:padding="24dp">

    <ImageView
        android:src="@drawable/ic_launcher_foreground"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:tint="@color/gold_primary" />

    <TextView
        android:text="GoldPay"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/gold_primary"
        android:layout_gravity="center"
        android:layout_marginTop="16dp" />

    <TextView
        android:text="Smart Banking, Golden Touch"
        android:textSize="14sp"
        android:textColor="@color/gray_700"
        android:layout_gravity="center"
        android:layout_marginTop="4dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:radius="16dp"
        android:elevation="4dp"
        android:layout_marginTop="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:text="Welcome Back"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/gray_700"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                
                >

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLines="1" />

            </LinearLayout>

            <Button
                android:id="@+id/btnLogin"
                android:text="Continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/gold_primary"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="12dp" />

            <TextView
                android:text="Demo PIN: 1234"
                android:textSize="12sp"
                android:textColor="@color/gray_700"
                android:layout_marginTop="12dp"
                android:gravity="center" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:text="This is a demo app for educational purposes. All balances are simulated."
        android:textSize="11sp"
        android:textColor="@color/gray_700"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:alpha="0.7" />

</LinearLayout>
